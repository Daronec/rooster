# Appwrite Configuration
APPWRITE_PROJECT_ID=rooster
APPWRITE_PUBLIC_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_OAUTH_SUCCESS_URL=appwrite-callback-rooster://
APPWRITE_OAUTH_FAILURE_URL=appwrite-callback-rooster://failure
APPWRITE_PASSWORD_RECOVERY_REDIRECT_URL=appwrite-callback-rooster://recovery
APPWRITE_TEAM_INVITE_RETURN_URL=appwrite-callback-rooster://team-invite

# Sber ID Native SDK Configuration
SBER_CLIENT_ID=your_sber_client_id_here
SBER_SCOPE=GIGACHAT_API_PERS
SBER_AUTH_KEY=your_sber_auth_key_here

# Optional: Sync Database IDs (for cloud sync)
# APPWRITE_SYNC_DATABASE_ID=
# APPWRITE_SYNC_TASKS_COLLECTION_ID=
# APPWRITE_SYNC_LISTS_COLLECTION_ID=
# APPWRITE_SYNC_PLANS_COLLECTION_ID=
# APPWRITE_SYNC_MATERIALS_COLLECTION_ID=
# APPWRITE_SYNC_TASK_IMAGES_BUCKET_ID=

# Optional: Disable Appwrite
# APPWRITE_DISABLED=false
